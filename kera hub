local function GetPlayerList()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(list, player.DisplayName .. " (" .. player.Name .. ")")
		end
	end
	if #list == 0 then
		table.insert(list, "No Players")
	end
	return list
end

local function GetPlayerFromDropdown(selectedString)
	if not selectedString or selectedString == "" then return nil end
	local username = string.match(selectedString, "%((.-)%)")
	if username then
		return Players:FindFirstChild(username)
	end
	return nil
end

local function ClaimOwnership(part, cf)
	if not part or not part:IsA("BasePart") then return end
	pcall(function()
		if destroyGrabLineEvent then
			destroyGrabLineEvent:FireServer(part)
		end
		if setNetworkOwnerEvent then
			setNetworkOwnerEvent:FireServer(part, cf or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.CFrame))
		end
	end)
end

local function IsValidGrabbedPart(part)
	if not part or not part:IsA("BasePart") then return false end
	if part.Anchored then return false end
	local forbiddenNames = {"baseplate", "floor", "ground", "map", "terrain", "spawn"}
	local nameLower = string.lower(part.Name)
	for _, name in ipairs(forbiddenNames) do
		if string.find(nameLower, name) then return false end
	end
	if part.Parent and part.Parent:IsA("Model") then
		local modelName = string.lower(part.Parent.Name)
		for _, name in ipairs(forbiddenNames) do
			if string.find(modelName, name) then return false end
		end
	end
	return true
end

local function GetGrabbedPartInfo()
	local grabPartsModel = Workspace:FindFirstChild("GrabParts")
	if not grabPartsModel then return nil, nil, nil end
	local partInfo = grabPartsModel:FindFirstChild("GrabPart")
	if not partInfo then return nil, nil, nil end
	local weld = partInfo:FindFirstChild("WeldConstraint")
	if not weld or not weld.Part1 then return nil, nil, nil end
	local targetPart = weld.Part1
	if not IsValidGrabbedPart(targetPart) then return nil, nil, nil end
	return targetPart, targetPart.Parent, grabPartsModel
end

local function GetGrabbedPallet()
	local part, model, grabModel = GetGrabbedPartInfo()
	if not part then return nil end
	local nameLower = string.lower(part.Name)
	local modelNameLower = model and string.lower(model.Name) or ""
	if string.find(nameLower, "pallet") or string.find(modelNameLower, "pallet") then
		return part
	end
	return nil
end

local function DoSpamGrab(targetRoot)
	if not targetRoot then return end
	pcall(function()
		if setNetworkOwnerEvent then
			setNetworkOwnerEvent:FireServer(targetRoot, LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.CFrame)
		end
		if destroyGrabLineEvent then
			destroyGrabLineEvent:FireServer(targetRoot)
		end
	end)
end

local function ExecutePalletFlingWithPart(targetPlayer, palletPart, useNetworkOwner)
	if not targetPlayer or not targetPlayer.Character then return end
	local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetHRP or not palletPart or not palletPart.Parent then return end
	local flingStartTime = tick()
	while tick() - flingStartTime < 2.5 do
		if not targetHRP or not targetHRP.Parent or not palletPart or not palletPart.Parent then break end
		local rotX = math.random(-360, 360)
		local rotY = math.random(-360, 360)
		local rotZ = math.random(-360, 360)
		local offset = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
		palletPart.CFrame = CFrame.new(targetHRP.Position + offset) * CFrame.Angles(math.rad(rotX), math.rad(rotY), math.rad(rotZ))
		palletPart.AssemblyLinearVelocity = Vector3.new(math.random(-2000, 2000), math.random(-2000, 2000), math.random(-2000, 2000))
		palletPart.AssemblyAngularVelocity = Vector3.new(math.random(-5000, 5000), math.random(-5000, 5000), math.random(-5000, 5000))
		if useNetworkOwner and setNetworkOwnerEvent then
			ClaimOwnership(palletPart, palletPart.CFrame)
		end
		RunService.Heartbeat:Wait()
	end
end

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseWheel and States.InfiniteReachEnabled then
		if pcDistance < 11 then
			pcDistance = 11
		end
		if input.Position.Z <= 0 then
			pcDistance = math.max(11, pcDistance - IncreaseLineExtend)
		else
			pcDistance = pcDistance + IncreaseLineExtend
		end
	end
end)

