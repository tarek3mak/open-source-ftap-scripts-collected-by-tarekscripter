		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			ShortcutKeyCode = input.KeyCode
			IsBindingShortcut = false
			SetShortcutButton:Set("shorcut: " .. ShortcutKeyCode.Name .. " (Click to change)")
		end
		return
	end

	if not gameProcessedEvent and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == ShortcutKeyCode then
		task.spawn(ToggleOrLaunchRocket)
	end
end)
