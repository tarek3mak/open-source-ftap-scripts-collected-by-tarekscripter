-- control missiles
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")

local MissileSpeed = 150
local IsLaunchingRocket = false
local CancelRocketRequested = false
local ShortcutKeyCode = Enum.KeyCode.G
local IsBindingShortcut = false

local function GetChar(player)
	return player and player.Character
end

local function GetHRH(character)
	if not character then
		return nil, nil, nil
	end
	return character:FindFirstChild("Head"), character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
end

local function TeleportPart(part, targetCFrame, offsetCFrame)
	if part and part.Parent and targetCFrame then
		part.CFrame = targetCFrame * (offsetCFrame or CFrame.new())
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
end

local function GetGroundedCFrame(character, hrp, humanoid, originCFrame)
	if not hrp then
		return originCFrame
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = { character }
	local toysFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
	if toysFolder then
		table.insert(ignoreList, toysFolder)
	end
	rayParams.FilterDescendantsInstances = ignoreList

	local rayOrigin = hrp.Position + Vector3.new(0, 1, 0)
	local rayDirection = Vector3.new(0, -120, 0)
	local result = workspace:Raycast(rayOrigin, rayDirection, rayParams)

	if result then
		local hipOffset = (humanoid and humanoid.HipHeight > 0 and humanoid.HipHeight or 2) + (hrp.Size.Y * 0.5)
		local groundedPos = Vector3.new(hrp.Position.X, result.Position.Y + hipOffset, hrp.Position.Z)
		local _, rotY, rotZ = (originCFrame or hrp.CFrame):ToEulerAnglesYXZ()
		return CFrame.new(groundedPos) * CFrame.fromEulerAnglesYXZ(0, rotY, rotZ)
	end

	return originCFrame or hrp.CFrame
end

local function SetCharacterAnchorState(character, anchored, groundIfAnchored, originCFrame)
	if not character then
		return nil
	end

	local _, hrp, humanoid = GetHRH(character)
	local targetCFrame = originCFrame or (hrp and hrp.CFrame)

	if anchored and groundIfAnchored and hrp then
		targetCFrame = GetGroundedCFrame(character, hrp, humanoid, targetCFrame)
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = false
			end
		end
		TeleportPart(hrp, targetCFrame, CFrame.new())
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = anchored
			if anchored then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end

	return targetCFrame
end

local function GetToysFolder()
	return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

local function GetPlot()
	if not workspace:FindFirstChild("PlotItems") or not workspace.PlotItems:FindFirstChild("PlayersInPlots") then
		return false, nil
	end
	if not workspace.PlotItems.PlayersInPlots:FindFirstChild(LocalPlayer.Name) then
		return false, nil
	end
	for _, plot in ipairs(workspace.Plots:GetChildren()) do
		local plotSign = plot:FindFirstChild("PlotSign")
		local owners = plotSign and plotSign:FindFirstChild("ThisPlotsOwners")
		if owners then
			for _, ownerVal in ipairs(owners:GetChildren()) do
				if ownerVal.Value == LocalPlayer.Name then
					local plotItems = workspace.PlotItems:FindFirstChild(plot.Name)
					if plotItems then
						return true, plotItems
					end
				end
			end
		end
	end
	return false, nil
end

local function NewToy(toyName, spawnCFrame)
	local toysFolder = GetToysFolder()
	if not toyName or not spawnCFrame or not toysFolder then
		return nil
	end
	repeat
		task.wait()
	until CancelRocketRequested or not LocalPlayer:FindFirstChild("CanSpawnToy") or LocalPlayer.CanSpawnToy.Value

	if CancelRocketRequested then
		return nil
	end

	local startTime = tick()
	local spawned = nil

	task.spawn(function()
		while not spawned and not CancelRocketRequested and (tick() - startTime) <= 1.5 do
			pcall(function()
				ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(toyName, spawnCFrame, Vector3.zero)
			end)
			task.wait(0.1)
		end
	end)

	local hasPlot, plotItems = GetPlot()
	if hasPlot and plotItems then
		spawned = plotItems:WaitForChild(toyName, 1.5)
	end
	if not spawned then
		spawned = toysFolder:WaitForChild(toyName, 1.5)
	end
	return spawned
end

local function DestroyToy(toy)
	if toy and toy.Parent then
		pcall(function()
			ReplicatedStorage.MenuToys.DestroyToy:FireServer(toy)
		end)
	end
end

local function HasOwner(part)
	if not part or not part.Parent then
		return false, nil
	end
	local ownerObj = part:FindFirstChild("PartOwner")
	if ownerObj then
		return ownerObj.Value == LocalPlayer.Name, ownerObj.Value
	end
	return false, nil
end

local function ClaimControlWithRetry(targetPart, referencePart, humanoid, maxDuration, returnCFrame)
	if not targetPart or not targetPart.Parent or not referencePart or not referencePart.Parent then
		return false
	end

	local owned = HasOwner(targetPart)
	if owned then
		return true
	end

	local savedPlayerCFrame = returnCFrame or referencePart.CFrame
	local deadline = tick() + (maxDuration or 6)

	while not CancelRocketRequested and targetPart and targetPart.Parent and referencePart and referencePart.Parent and humanoid and humanoid.Health > 0 and tick() < deadline do
		local isMine = HasOwner(targetPart)
		if isMine then
			SetCharacterAnchorState(referencePart.Parent, false, false)
			TeleportPart(referencePart, savedPlayerCFrame, CFrame.new())
			SetCharacterAnchorState(referencePart.Parent, true, false)
			return true
		end

		SetCharacterAnchorState(referencePart.Parent, false, false)
		TeleportPart(referencePart, targetPart.CFrame, CFrame.new(0, -1.5, 3))
		SetCharacterAnchorState(referencePart.Parent, true, false)

		pcall(function()
			SetNetworkOwner:FireServer(targetPart, targetPart.CFrame)
		end)

		task.wait(0.05)
	end

	SetCharacterAnchorState(referencePart.Parent, false, false)
	TeleportPart(referencePart, savedPlayerCFrame, CFrame.new())
	if not CancelRocketRequested then
		SetCharacterAnchorState(referencePart.Parent, true, false)
	end
	return HasOwner(targetPart)
end

local function GetCameraRelativeVector(camCFrame, moveDir)
	if moveDir.Magnitude <= 0.05 then
		return Vector3.zero
	end

	local localMove = camCFrame:VectorToObjectSpace(moveDir)
	local forwardAmount = -localMove.Z
	local rightAmount = localMove.X

	local direction = (camCFrame.LookVector * forwardAmount) + (camCFrame.RightVector * rightAmount)
	if direction.Magnitude > 1 then
		direction = direction.Unit
	end

	return direction
end

local function CleanupRocketLaunch(bombMissile, bodyVelocity, bodyGyro, anchorOriginCFrame, originalCameraSubject, humanoid)
	if bodyVelocity and bodyVelocity.Parent then
		bodyVelocity:Destroy()
	end
	if bodyGyro and bodyGyro.Parent then
		bodyGyro:Destroy()
	end

	local currentChar = GetChar(LocalPlayer)
	SetCharacterAnchorState(currentChar, false, false)

	local _, currentHRP = GetHRH(currentChar)
	if currentHRP and anchorOriginCFrame then
		TeleportPart(currentHRP, anchorOriginCFrame, CFrame.new())
	end

	if humanoid and humanoid.Parent then
		workspace.CurrentCamera.CameraSubject = humanoid
	elseif originalCameraSubject then
		workspace.CurrentCamera.CameraSubject = originalCameraSubject
	end

	DestroyToy(bombMissile)
	IsLaunchingRocket = false
	CancelRocketRequested = false
end

local function ToggleOrLaunchRocket()
	if IsLaunchingRocket then
		CancelRocketRequested = true
		return
	end

	local character = GetChar(LocalPlayer)
	local _, hrp, humanoid = GetHRH(character)
	local toysFolder = GetToysFolder()

	if not hrp or not humanoid or humanoid.Health <= 0 or not toysFolder then
		return
	end

	IsLaunchingRocket = true
	CancelRocketRequested = false

	local originalCameraSubject = workspace.CurrentCamera.CameraSubject
	local anchorOriginCFrame = SetCharacterAnchorState(character, true, true, hrp.CFrame)
	local bombMissile = nil
	local bodyVelocity = nil
	local bodyGyro = nil

	for _, item in ipairs(toysFolder:GetChildren()) do
		if item.Name == "BombMissile" or item.Name == "ActiveLaunchRocket" then
			item.Name = "OldRocket"
			DestroyToy(item)
		end
	end

	bombMissile = NewToy("BombMissile", anchorOriginCFrame * CFrame.new(0, 15, 20))
	if not bombMissile or CancelRocketRequested then
		CleanupRocketLaunch(bombMissile, bodyVelocity, bodyGyro, anchorOriginCFrame, originalCameraSubject, humanoid)
		return
	end

	bombMissile.Name = "ActiveLaunchRocket"

	local controlPart = bombMissile:WaitForChild("Part", 1.5)
	local orientingPart = bombMissile:WaitForChild("OrientingPart", 1.5)

	if not controlPart or not orientingPart or CancelRocketRequested then
		CleanupRocketLaunch(bombMissile, bodyVelocity, bodyGyro, anchorOriginCFrame, originalCameraSubject, humanoid)
		return
	end

	local gotInitialControl = ClaimControlWithRetry(controlPart, hrp, humanoid, 3, anchorOriginCFrame)
	if not gotInitialControl or CancelRocketRequested then
		CleanupRocketLaunch(bombMissile, bodyVelocity, bodyGyro, anchorOriginCFrame, originalCameraSubject, humanoid)
		return
	end

	bodyVelocity = orientingPart:FindFirstChild("RocketBodyVelocity") or Instance.new("BodyVelocity")
	bodyVelocity.Name = "RocketBodyVelocity"
	bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVelocity.P = 12500
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = orientingPart

	bodyGyro = orientingPart:FindFirstChild("RocketBodyGyro") or Instance.new("BodyGyro")
	bodyGyro.Name = "RocketBodyGyro"
	bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bodyGyro.D = 1000
	bodyGyro.P = 90000
	bodyGyro.CFrame = workspace.CurrentCamera.CFrame * CFrame.Angles(-math.pi / 2, 0, math.pi / 2)
	bodyGyro.Parent = orientingPart

	local holdAnchorPosition = orientingPart.Position
	local wasMoving = false

	while not CancelRocketRequested and bombMissile and bombMissile.Parent and orientingPart and orientingPart.Parent and controlPart and controlPart.Parent and humanoid and humanoid.Health > 0 do
		local currentChar = GetChar(LocalPlayer)
		local _, currentHRP, currentHum = GetHRH(currentChar)
		if not currentHRP or not currentHum or currentHum.Health <= 0 then
			break
		end

		SetCharacterAnchorState(currentChar, true, false)
		TeleportPart(currentHRP, anchorOriginCFrame, CFrame.new())

		local isMine = HasOwner(controlPart)
		if not isMine then
			bodyVelocity.Velocity = Vector3.zero
			while not CancelRocketRequested and bombMissile and bombMissile.Parent and controlPart and controlPart.Parent and currentHRP and currentHRP.Parent and currentHum and currentHum.Health > 0 and not HasOwner(controlPart) do
				SetCharacterAnchorState(currentChar, false, false)
				TeleportPart(currentHRP, controlPart.CFrame, CFrame.new(0, -1.5, 3))
				SetCharacterAnchorState(currentChar, true, false)

				pcall(function()
					SetNetworkOwner:FireServer(controlPart, controlPart.CFrame)
				end)

				task.wait(0.05)
			end

			SetCharacterAnchorState(currentChar, false, false)
			TeleportPart(currentHRP, anchorOriginCFrame, CFrame.new())
			SetCharacterAnchorState(currentChar, true, false)
			holdAnchorPosition = orientingPart.Position
		end

		workspace.CurrentCamera.CameraSubject = orientingPart

		local camCFrame = workspace.CurrentCamera.CFrame
		local targetGyroCFrame = camCFrame * CFrame.Angles(-math.pi / 2, 0, math.pi / 2)
		bodyGyro.CFrame = targetGyroCFrame

		local steerDir = GetCameraRelativeVector(camCFrame, currentHum.MoveDirection)
		if steerDir.Magnitude > 0.05 then
			wasMoving = true
			bodyVelocity.Velocity = steerDir * MissileSpeed
			holdAnchorPosition = orientingPart.Position
		else
			if wasMoving then
				wasMoving = false
				holdAnchorPosition = orientingPart.Position
			end

			local delta = holdAnchorPosition - orientingPart.Position
			if delta.Magnitude > 0.05 then
				bodyVelocity.Velocity = delta * 18
			else
				bodyVelocity.Velocity = Vector3.zero
				TeleportPart(orientingPart, CFrame.new(holdAnchorPosition) * targetGyroCFrame.Rotation, CFrame.new())
			end
		end

		RunService.RenderStepped:Wait()
	end

	CleanupRocketLaunch(bombMissile, bodyVelocity, bodyGyro, anchorOriginCFrame, originalCameraSubject, humanoid)
end

