CustomTab_8_224:CreateButton({
    Name = "break grabbed part",
    Callback = function()
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local RunService = game:GetService("RunService")

        local LocalPlayer = Players.LocalPlayer
        local toysFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
        local PlayerEvents = ReplicatedStorage:WaitForChild("PlayerEvents")
        local SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
        local StickyPartEvent = PlayerEvents:WaitForChild("StickyPartEvent")
        local DestroyToy = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
        local SpawnToyRemoteFunction = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")

        local BreakMode = "Noclip"
        local HighlightColor = Color3.fromRGB(237, 198, 255)
        local MaxAttempts = 5

        _G.NileBreakState = _G.NileBreakState or {
        	Records = {},
        	Watcher = nil,
        }

        local State = _G.NileBreakState

        local function RemoveSelectionBox(part)
        	if part and part:FindFirstChild("SelectedToBreak") then
        		part.SelectedToBreak:Destroy()
        	end
        end

        local function DisableTouch(model)
        	for _, descendant in ipairs(model:GetDescendants()) do
        		if descendant:IsA("BasePart") then
        			descendant.CanTouch = false
        		end
        	end
        end

        local function ClaimOwnershipImmediately(shuriken, soundPart)
        	local char = LocalPlayer.Character
        	local hrp = char and char:FindFirstChild("HumanoidRootPart")
        	local owner = soundPart:FindFirstChild("PartOwner")
        	local startTime = tick()

        	while soundPart and soundPart.Parent and hrp and hrp.Parent do
        		if owner and owner.Value == LocalPlayer.Name then
        			return true
        		end
        		pcall(function()
        			SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
        		end)
        		owner = soundPart:FindFirstChild("PartOwner")
        		if owner and owner.Value == LocalPlayer.Name then
        			return true
        		end
        		if tick() - startTime > 1 then
        			break
        		end
        		RunService.Heartbeat:Wait()
        	end

        	return owner and owner.Value == LocalPlayer.Name
        end

        local function SpawnShuriken(name)
        	local char = LocalPlayer.Character
        	local hrp = char and char:FindFirstChild("HumanoidRootPart")
        	if not hrp then
        		return nil
        	end

        	local waitStart = tick()
        	while not (hrp.Parent and LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value and LocalPlayer:FindFirstChild("InPlot") and not LocalPlayer.InPlot.Value) do
        		task.wait()
        		if tick() - waitStart > 3 then
        			return nil
        		end
        	end

        	local spawnCF = hrp.CFrame * CFrame.new(0, 5, 0)
        	local shuriken = nil
        	local conn

        	if toysFolder then
        		conn = toysFolder.ChildAdded:Connect(function(child)
        			if child.Name == "NinjaShuriken" and not shuriken then
        				shuriken = child
        				DisableTouch(child)
        				local sp = child:FindFirstChild("SoundPart")
        				if sp then
        					task.spawn(function()
        						pcall(function()
        							SetNetworkOwner:FireServer(sp, sp.CFrame)
        						end)
        					end)
        				end
        			end
        		end)
        	end

        	task.spawn(function()
        		pcall(function()
        			SpawnToyRemoteFunction:InvokeServer("NinjaShuriken", spawnCF, Vector3.zero)
        		end)
        	end)

        	local grabStart = tick()
        	while not shuriken and tick() - grabStart < 1.2 do
        		if toysFolder and toysFolder:FindFirstChild("NinjaShuriken") then
        			shuriken = toysFolder:FindFirstChild("NinjaShuriken")
        			DisableTouch(shuriken)
        			break
        		end
        		RunService.Heartbeat:Wait()
        	end

        	if conn then
        		conn:Disconnect()
        	end

        	if not shuriken then
        		return nil
        	end

        	DisableTouch(shuriken)

        	local soundPart = shuriken:FindFirstChild("SoundPart") or shuriken:WaitForChild("SoundPart", 1)
        	if not soundPart then
        		pcall(function()
        			DestroyToy:FireServer(shuriken)
        		end)
        		return nil
        	end

        	soundPart.CanTouch = false

        	if ClaimOwnershipImmediately(shuriken, soundPart) then
        		if not soundPart:FindFirstChild("BodyPosition") then
        			local bp = Instance.new("BodyPosition")
        			bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        			bp.D = 100
        			bp.Position = Vector3.new(math.random(-100000, 100000), 100000, math.random(-100000, 100000))
        			bp.Parent = soundPart
        		end
        		shuriken.Name = name
        		return shuriken
        	end

        	pcall(function()
        		DestroyToy:FireServer(shuriken)
        	end)
        	return nil
        end

        local function TryBreakPart(part1)
        	if not part1 or not part1.Parent then
        		return false
        	end

        	local origCF = part1.CFrame
        	local origAnchored = part1.Anchored
        	local origCollide = part1.CanCollide
        	local origQuery = part1.CanQuery

        	for attempt = 1, MaxAttempts do
        		if not part1 or not part1.Parent or not part1:FindFirstChild("SelectedToBreak") then
        			return false
        		end

        		local breaker = SpawnShuriken("BreakMapPartsShuriken")
        		local stickyPart = breaker and breaker:FindFirstChild("StickyPart")

        		if breaker and stickyPart then
        			local targetCF = (BreakMode == "Kick") and CFrame.new(0, -2.3e9, 0) or CFrame.new(2199023255552, 2199023255552, 2199023255552)
        			local ok = pcall(function()
        				StickyPartEvent:FireServer(stickyPart, part1, targetCF)
        			end)

        			if ok then
        				table.insert(State.Records, {
        					Part = part1,
        					Breaker = breaker,
        					StickyPart = stickyPart,
        					CFrame = origCF,
        					Anchored = origAnchored,
        					CanCollide = origCollide,
        					CanQuery = origQuery,
        				})
        				breaker.Parent = nil
        				return true
        			end

        			if toysFolder then
        				breaker.Parent = toysFolder
        			end
        			pcall(function()
        				DestroyToy:FireServer(breaker)
        			end)
        		end

        		if attempt < MaxAttempts then
        			task.wait(0.25)
        		end
        	end

        	RemoveSelectionBox(part1)
        	return false
        end

        if State.Watcher then
        	State.Watcher:Disconnect()
        end

        State.Watcher = workspace.ChildAdded:Connect(function(child)
        	if child.Name == "GrabParts" then
        		local grabPart = child:WaitForChild("GrabPart", 1)
        		local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
        		local part1 = weld and weld.Part1

        		if part1 and part1:IsA("BasePart") and not part1:FindFirstChild("SelectedToBreak") then
        			local box = Instance.new("SelectionBox", part1)
        			box.Adornee = part1
        			box.LineThickness = 0
        			box.SurfaceColor3 = HighlightColor
        			box.SurfaceTransparency = 0.75
        			box.Name = "SelectedToBreak"

        			if State.Watcher then
        				State.Watcher:Disconnect()
        				State.Watcher = nil
        			end

        			task.spawn(function()
        				TryBreakPart(part1)
        			end)
        		end
        	end
        end)
    end,
})

