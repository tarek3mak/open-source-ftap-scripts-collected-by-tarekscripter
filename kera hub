local inexistance = {}
local itm
local sp
local sv
local humconnection
local gucciRunning = false
local selectedGucciType = 'CreatureBlobman'

local function getCharParts()
    local char = LocalPlayer.Character
    if not char then
        return nil, nil
    end
    return char:FindFirstChild('Humanoid'), char:FindFirstChild('HumanoidRootPart')
end

local function diddle()
    if itm then
        for _, prt in pairs(itm:GetChildren()) do
            if prt:IsA('BasePart') then
                prt.CanCollide = false
            end
        end
    end
    local hum, hrp = getCharParts()
    if hrp and sp then hrp.CFrame = sp end
    if hrp and sv then hrp.AssemblyLinearVelocity = sv end
    if hum then hum:GetPropertyChangedSignal('SeatPart'):Once(diddle) end
end

local function checkgrab(part)
    pcall(function()
        SetNetworkOwner:FireServer(part, part.CFrame)
    end)
end

local function gucciblob()
    if gucciRunning then
        return
    end
    gucciRunning = true

    local guccion = false
    local tickyticky = tick()

    while States.GucciAntiGrab do
        local hum, hrp = getCharParts()

        if hum and hrp then
            local dt = tick() - tickyticky
            tickyticky = tick()

            if itm and itm:FindFirstChild('VehicleSeat') then
                local occupant = itm.VehicleSeat.Occupant
                if occupant and occupant ~= hum then
                    task.spawn(function()
                        DestroyToy:FireServer(itm)
                    end)
                    itm = nil
                    guccion = false
                    inexistance = {}
                    task.wait(0.1)
                    if LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value then
                        task.spawn(function()
                            SpawnToyRemoteFunction:InvokeServer(selectedGucciType, hrp.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                        end)
                    end
                    task.wait()
                    continue
                end
            end

            if itm and itm.Parent and not ((itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')) and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant ~= hum) or (inexistance[itm] or 0) < 1) then
                task.spawn(function()
                    DestroyToy:FireServer(itm)
                end)
            else
                local toyFolder = workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
                itm = toyFolder and toyFolder:FindFirstChild(selectedGucciType)
            end

            if not sp or not hum.SeatPart then
                sp = hrp.CFrame
                sv = hrp.AssemblyLinearVelocity
            end

            if humconnection ~= hum then
                humconnection = hum
                hum:GetPropertyChangedSignal('SeatPart'):Once(diddle)
            end

            local wait = true

            if itm then
                inexistance[itm] = (inexistance[itm] or 0) + dt

                if (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')) and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant == hum) then
                    if not guccion then
                        local partToVel = itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')
                        if partToVel then partToVel.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
                    end

                    local diddy = itm.VehicleSeat
                    diddy.Parent = nil
                    diddy.Parent = itm

                    local mainPart = itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')
                    if not checkgrab(itm) and mainPart and (hrp.CFrame.Position - mainPart.CFrame.Position).Magnitude < 28 then
                        for _, prt in pairs(itm:GetChildren()) do
                            if prt:IsA('BasePart') and prt.CanQuery then
                                SetNetworkOwner:FireServer(prt, CFrame.lookAt(hrp.CFrame.Position, prt.CFrame.Position))
                            end
                        end
                    end

                    if not hum.SeatPart then
                        hum.Sit = false
                    else
                        wait = false
                        task.wait()
                    end

                    if hrp and hum and mainPart and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant == hum) then
                        local ragdolled = hum:FindFirstChild('Ragdolled')
                        if ragdolled and ragdolled.Value then
                            guccion = false
                        end

                        if itm.VehicleSeat.Occupant == hum then
                            guccion = true
                        elseif not guccion then
                            task.wait()
                            wait = false
                            if mainPart and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant == hum) then
                                local ragdolled2 = hum:FindFirstChild('Ragdolled')
                                if not ragdolled2 or not ragdolled2.Value then
                                    itm.VehicleSeat:Sit(hum)
                                    RagdollRemote:FireServer(hrp, 0.016)
                                end
                            end
                        end

                        if guccion then
                            if mainPart then mainPart.AssemblyLinearVelocity = Vector3.new(0, 1e15, 0) end
                        else
                            local ping = 100
                            pcall(function() ping = game:GetService("Stats").Network.ServerStatsItem['Data Ping']:GetValue() end)
                            if inexistance[itm] >= ping / 250 then
                                task.spawn(function()
                                    DestroyToy:FireServer(itm)
                                end)
                                hum.Sit = true
                            end
                        end
                    end
                else
                    if guccion then
                        hum.Sit = true
                    end
                    guccion = false
                    if inexistance[itm] and inexistance[itm] >= 1 then
                        task.spawn(function()
                            DestroyToy:FireServer(itm)
                        end)
                        if LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value then
                            task.spawn(function()
                                SpawnToyRemoteFunction:InvokeServer(selectedGucciType, hrp.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                            end)
                        end
                    end
                end
            else
                if guccion then
                    guccion = false
                    hum.Sit = true
                end
                if LocalPlayer:FindFirstChild("CanSpawnToy") and LocalPlayer.CanSpawnToy.Value then
                    task.spawn(function()
                        SpawnToyRemoteFunction:InvokeServer(selectedGucciType, hrp.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                    end)
                end
            end

            if wait then
                task.wait()
                hum.Sit = false
            end
        else
            task.wait()
        end
    end
    gucciRunning = false
end

